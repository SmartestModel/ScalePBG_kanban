rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function getMemberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(currentUid()));
    }

    function isMember(orgId) {
      return isAuthenticated() && getMemberDoc(orgId).data != null;
    }

    function getRole(orgId) {
      return getMemberDoc(orgId).data.role;
    }

    function isAdmin(orgId) {
      return isAuthenticated() && getRole(orgId) == 'admin';
    }

    function isLeadOrAdmin(orgId) {
      return isAuthenticated() && (getRole(orgId) == 'admin' || getRole(orgId) == 'lead');
    }

    // ── Organizations ────────────────────────────────────────────────────

    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin(orgId);

      match /members/{memberId} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }
    }

    // ── Access Requests ──────────────────────────────────────────────────

    match /access_requests/{requestId} {
      // Anyone authenticated can create a request
      allow create: if isAuthenticated() && request.resource.data.userId == currentUid();
      // Requester can read their own request; org admins can read all for their org
      allow read: if isAuthenticated() && (
        resource.data.userId == currentUid() ||
        isAdmin(resource.data.orgId)
      );
      // Only org admin can update (approve/reject)
      allow update: if isAdmin(resource.data.orgId);
      allow delete: if isAdmin(resource.data.orgId);
    }

    // ── Users (profile sync) ─────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && currentUid() == userId;
    }

    // ── Projects ─────────────────────────────────────────────────────────

    match /projects/{projectId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isLeadOrAdmin(request.resource.data.orgId);
      allow update: if isLeadOrAdmin(resource.data.orgId);
      allow delete: if isAdmin(resource.data.orgId);
    }

    // ── Epics ────────────────────────────────────────────────────────────

    match /epics/{epicId} {
      allow read: if isAuthenticated();
      allow write: if isLeadOrAdmin(
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.orgId
      );
    }

    // ── Stories ──────────────────────────────────────────────────────────

    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Tasks ─────────────────────────────────────────────────────────────

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isLeadOrAdmin(
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.orgId
        ) ||
        resource.data.assigneeId == currentUid()
      );
      allow delete: if isLeadOrAdmin(
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.orgId
      );
    }

    // ── Sprints ───────────────────────────────────────────────────────────

    match /sprints/{sprintId} {
      allow read: if isAuthenticated();
      allow write: if isLeadOrAdmin(
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.orgId
      );
    }

    // ── Sprint Items ──────────────────────────────────────────────────────

    match /sprint_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Comments ──────────────────────────────────────────────────────────

    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == currentUid();
      allow update, delete: if isAuthenticated() && resource.data.userId == currentUid();
    }

    // ── Activity Logs ─────────────────────────────────────────────────────

    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
